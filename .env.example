# Local tests are offline. Only the opt-in live smoke command reads this file.
OPENAI_API_KEY=
LOOPGRAPH_MODEL=gpt-5.4-mini
LOOPGRAPH_TIMEZONE=America/New_York
LOOPGRAPH_LLM_TIMEOUT_SECONDS=60
LOOPGRAPH_LLM_MAX_OUTPUT_TOKENS=12000
# Copy to .env and fill in. Never commit the real .env.

# --- Composio ----------------------------------------------------------
# Must be a PROJECT api key (x-api-key), from platform.composio.dev.
# Not a ck_ Connect key and not a uak_ CLI key -- both fail with a
# generic "Invalid API key" 401.
COMPOSIO_API_KEY=
USER_ID=
PROJECT_ID=

# --- Connected accounts ------------------------------------------------
# Written automatically by scripts/connect_apps.py. Leave blank.
GMAIL_ACCOUNT_ID=
CALENDAR_ACCOUNT_ID=
SLACK_ACCOUNT_ID=
DRIVE_ACCOUNT_ID=

# --- Handing off -------------------------------------------------------
# Optional. POST every normalized Event onward to the next stage
# (LangGraph). This is OUTBOUND -- nothing needs to reach us, so no
# tunnel is involved. Leave blank and Events are only logged and served
# from GET /events.
LOOPGRAPH_WEBHOOK_URL=

# Poll intervals are per-app and live in backend/app/events/poller.py,
# because Slack's rate limit is an order of magnitude tighter than
# Google's and a single shared number cannot serve both.
