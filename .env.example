# Copy to .env and fill in. Never commit the real .env.

# --- Composio ----------------------------------------------------------
# Must be a PROJECT api key (x-api-key), from platform.composio.dev.
# Not a ck_ Connect key and not a uak_ CLI key -- both fail with a
# generic "Invalid API key" 401.
COMPOSIO_API_KEY=
USER_ID=
PROJECT_ID=

# --- Connected accounts ------------------------------------------------
# Written automatically by connect.py. Leave blank.
GMAIL_ACCOUNT_ID=
CALENDAR_ACCOUNT_ID=
SLACK_ACCOUNT_ID=
DRIVE_ACCOUNT_ID=

# --- Tuning ------------------------------------------------------------
# How often Gmail is polled directly, in seconds.
POLL_SECONDS=5

# Interval for the Composio poll triggers (Drive, Calendar), in minutes.
# Slack is a real webhook and ignores this.
POLL_INTERVAL_MINUTES=1

# Optional: POST every normalized Event onward to the next stage (LangGraph).
# Leave blank and events are only logged + served from GET /events.
LOOPGRAPH_WEBHOOK_URL=

# Optional: verify Composio webhook signatures. Get it from the project's
# webhook settings. Leave blank to skip verification (fine locally).
COMPOSIO_WEBHOOK_SECRET=
